  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "ink": "^7.0.5",
    "inquirer": "^14.0.2",
    "ora": "^9.4.0",
    "react": "^19.2.7",
    "react-devtools-core": "^7.0.1"
  }
}
