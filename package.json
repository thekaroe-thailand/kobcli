{
  "name": "kob-cli",
  "version": "1.0.6",
  "description": "KOB CLI — AI-powered code generation tool. Built by Kob AI, made in Thailand.",
  "type": "module",
  "bin": {
    "kob": "bin/cli.cjs"
  },
  "files": [
    "bin/",
    "src/",
    "LICENSE",
    "README.md",
    "AGENTS.md",
    "INSTALL.md",
    "MANUAL.md",
    "QUICKSTART.md",
    "SPECTS.md",
    ".env.example"
  ],
  "scripts": {
    "dev": "bun run src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --compile --outfile kob-cli",
    "prepublishOnly": "bun run build",
    "publish": "bun run src/scripts/release.ts",
    "release:patch": "npm version patch --no-git-tag-version && npm publish",
    "release:minor": "npm version minor --no-git-tag-version && npm publish",
    "release:major": "npm version major --no-git-tag-version && npm publish"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "bun": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "Kob AI",
    "url": "https://www.kob-ai.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thekaroe-thailand/kobcli.git"
  },
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://www.kob-ai.dev",
  "bugs": {
    "url": "https://github.com/thekaroe-thailand/kobcli/issues"
  },
  "keywords": [
    "kob",
    "ai",
    "cli",
    "code-generation",
    "chat",
    "terminal",
    "thailand"
  ],
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/inquirer": "^9.0.9",
    "@types/react": "^19.2.16"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "ink": "^7.0.5",
    "inquirer": "^14.0.2",
    "ora": "^9.4.0",
    "react": "^19.2.7",
    "react-devtools-core": "^7.0.1"
  }
}
