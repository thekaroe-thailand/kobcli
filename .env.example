# ════════════════════════════════════════════════════════════
#  KOB CLI v2 — Configuration
#  Made in Thailand · www.kob-ai.dev
# ════════════════════════════════════════════════════════════

# Base URL for the KOB AI API (OpenAI-compatible)
KOB_API_BASE_URL=https://www.kob-ai.dev

# Your API key. Format: "kob_xxx:token" or just "kob_xxx"
KOB_API_KEY=kob_your_api_key_here

# Default model id (provider/model). Optional.
KOB_MODEL_ID=deepseek/deepseek-v4-flash

# Optional: max output tokens per response (default 16384)
# KOB_MAX_TOKENS=16384

# Optional: auto-approve safe read-only shell commands (true/false, default true)
# KOB_AUTO_APPROVE_READONLY=true
